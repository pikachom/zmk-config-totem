#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
                &kp Q  &kp W  &kp E               &kp R               &kp T        &kp Y        &kp U          &kp I                    &kp O             &kp P
                &kp A  &kp S  &kp D               &kp F               &kp G        &kp H        &kp J          &kp K                    &kp L             &kp SEMI
&kp LEFT_SHIFT  &kp Z  &kp X  &kp C               &kp V               &kp B        &kp N        &kp M          &mt LEFT_CONTROL COMMA   &mt LEFT_ALT DOT  &mt LEFT_GUI FSLH  &kp APOS
                              &mt LEFT_ALT SPACE  &mt LEFT_GUI SPACE  &lt 1 TAB    &lt 2 ENTER  &kp BACKSPACE  &mt LEFT_SHIFT CAPSLOCK
            >;
        };

        nav {
            bindings = <
                &kp ESCAPE          &kp BACKSPACE  &kp UP     &kp DELETE     &none                 &none   &none   &none   &none  &none
                &kp LA(LEFT_ARROW)  &kp LEFT       &kp DOWN   &kp RIGHT      &kp LA(RIGHT)         &none   &none   &none   &none  &none
&kp LEFT_SHIFT  &kp LG(UP_ARROW)    &kp LG(LEFT)   &kp ENTER  &kp LG(RIGHT)  &kp LG(DOWN_ARROW)    &none   &none   &none   &none  &none  &kp RIGHT_SHIFT
                                                   &trans     &trans         &trans                &trans  &trans  &trans
            >;
        };

        num_sym {
            bindings = <
                &kp N1     &kp N2  &kp N3  &kp N4     &kp N5       &kp N6                &kp N7                 &kp N8     &kp N9      &kp N0
                &kp GRAVE  &none   &none   &kp MINUS  &kp EQUAL    &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &none      &none       &kp BACKSLASH
&kp LEFT_SHIFT  &none      &none   &none   &none      &none        &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp COMMA  &kp PERIOD  &kp SLASH      &kp RIGHT_SHIFT
                                   &trans  &trans     &trans       &trans                &trans                 &trans
            >;
        };

        device {
            bindings = <
       &none  &none  &none  &none  &none    &bt BT_SEL 0          &bt BT_SEL 1          &bt BT_SEL 2  &none  &none
       &none  &none  &none  &none  &none    &none                 &none                 &none         &none  &none
&none  &none  &none  &none  &none  &none    &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &none         &none  &none  &bt BT_CLR
                     &none  &none  &none    &none                 &none                 &none
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        device {
            if-layers = <2 1>;
            then-layer = <3>;
        };
    };
};
